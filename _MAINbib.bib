	title = {Understanding {Mental} {Health} {Organizations}’ {Instagram} {Through} {Visuals}: {A} {Content} {Analysis}},
	volume = {0},
	issn = {1041-0236},
	shorttitle = {Understanding {Mental} {Health} {Organizations}’ {Instagram} {Through} {Visuals}},
	url = {https://doi.org/10.1080/10410236.2023.2185350},
	doi = {10.1080/10410236.2023.2185350},
	abstract = {This study analyzed the content, visual features, and audience engagement data of Instagram posts from two mental health organizations over one year (N = 725). For content features, mental health literacy and communicative strategies were examined. Posts that promoted knowledge of mental disorders and treatments, used information and community strategy were more likely to receive higher audience engagement. Visual features of demographic segments, visual composition, and visual framing topics were analyzed. Images that covered an unspecific population, used illustrated images, and focused on anti-stigma topical frames obtained more engagement. Theoretical contributions and practical applications regarding visual message design and management on social media to promote mental health are also offered.},
