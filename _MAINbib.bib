@book{engebretsen_2020_DataVisualizationSociety,
	title = {Data {Visualization} in {Society}},
	copyright = {https://creativecommons.org/licenses/by-nc-nd/4.0/},
	isbn = {978-94-6372-290-2 978-90-485-4313-7},
	url = {https://www.aup.nl/en/book/9789463722902},
	abstract = {Today we are witnessing an increased use of data visualization in society. Across domains such as work, education and the news, various forms of graphs, charts and maps are used to explain, convince and tell stories. In an era in which more and more data are produced and circulated digitally, and digital tools make visualization production increasingly accessible, it is important to study the conditions under which such visual texts are generated, disseminated and thought to be of societal benefit. This book is a contribution to the multi-disciplined and multi-faceted conversation concerning the forms, uses and roles of data visualization in society. Do data visualizations do 'good' or 'bad'? Do they promote understanding and engagement, or do they do ideological work, privileging certain views of the world over others? The contributions in the book engage with these core questions from a range of disciplinary perspectives.},
	language = {en},
	urldate = {2024-04-04},
	publisher = {Amsterdam University Press},
	author = {Engebretsen, Martin and Kennedy, Helen and Walker, Jill and Aiello, Giorgia and Uberg, Torgeir and Masson, Eef and Van, Karin and Laaksonen, Salla-Maaria and Pääkkönen, Juho and Snaprud, Mikael and Velazquez, Andrea and L., Arran and Birchall, Christopher and Geenen, Daniela and Wieringa, Maranke and Simpson, Jill and Weber, Wibke and Tønnessen, Elise Seip and D’Ignazio, Catherine and Bhargava, Rahul and Pinney, Lulu and Archer, Arlene and Noakes, Travis and Brinch, Sara and Hiippala, Tuomo and Gray, Jonathan and Lechner, Verena Elisabeth and Alamalhodaei, Aria and Alberda, Alexandra and Feigenbaum, Anna and Wihbey, John P. and Jackson, Sarah J. and Cruz, Pedro M. and Welles, Brooke Foucault and Hill, Rosemary Lucy and Ricker, Britta and Kraak, Menno-Jan and Engelhardt, Yuri and Berti Suman, Anna and Gutiérrez, Miren and Cairo, Alberto},
