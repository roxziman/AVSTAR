@misc{lin_2021_VisualizationAestheticsBias,
	title = {Visualization aesthetics bias trust in science, news, and social media},
	url = {https://osf.io/dnr9s},
	doi = {10.31234/osf.io/dnr9s},
	abstract = {Scientists, policymakers, and the public rely on data visualizations to inform important decisions. The aesthetics of graphs may vary independent of data quality. Across five-preregistered studies (3,405 participants, 1,219 graphs), we comprehensively investigate whether the beauty of a graph influences how much people trust it. Results show that graph beauty predicts increased trust using real-world graphs across three important domains: social media, news, and scientific publications (Studies 1-3). This association had real-world correlates: graph beauty predicts increased citation and comment numbers. We next identified visual features that contribute to perceptions of graph beauty (Study 4). Using these features, we digitally manipulated graph beauty and showed that making a graph more beautiful causally increased trust (Study 5). This causal effect was driven by people’s heuristic that beautiful graphs were made by competent people (Study 5b). These findings reveal a novel source of bias and indicate the importance of promoting visualization literacy.},
	language = {en-us},
	urldate = {2024-10-03},
	publisher = {OSF},
	author = {Lin, Chujun and Thornton, Mark Allen},
	month = dec,
	year = {2021},
	keywords = {Aesthetics, Beauty-is-good Stereotype, Causal Effects, Data Visualizations, Misinformation, Public Trust, Publication Bias},
}

@inproceedings{zanan_2022_ReviewVisualDesign,
