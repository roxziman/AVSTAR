@incollection{obrien_holistic_2018,
	address = {Cham},
	series = {Human–{Computer} {Interaction} {Series}},
	title = {A {Holistic} {Approach} to {Measuring} {User} {Engagement}},
	isbn = {978-3-319-73374-6},
	url = {https://doi.org/10.1007/978-3-319-73374-6_6},
	abstract = {This chapter provides an overview of methodological approaches and current work in the evaluation of user engagement (UE). Using a series of propositions about the nature of engagement, I review a selection of recent research that utilizes varied methodological approaches to study UE in various human-computer interaction settings. The propositions and the reviewed literature are used to propose a methodological framework to guide decision making and reflection regarding how UE will be evaluated in a given context. The chapter concludes with reflections on broader issues related to how researchers’ methodological stances influence the evaluation of UE. Overall, the chapter argues that UE should be measured using a thoughtful mix of qualitative and quantitative methods, considering the particulars of the use context, and balancing established and emerging subjective and objective metrics.},
	language = {en},
